{
  "openapi": "3.0.3",
  "info": {
    "title": "Authentication Test API",
    "description": "A server to test and validate authentication schemes like Basic Auth and AWS Signature V4",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://18.209.251.101:3000",
      "description": "Production server"
    }
  ],
  "paths": {
    "/api/basic-auth": {
      "post": {
        "summary": "Validate Basic Authentication",
        "description": "Validates the username and password credentials sent in the 'Authorization' header using the Basic scheme. The credentials must be Base64 encoded.",
        "operationId": "validateBasicAuth",
        "requestBody": {
          "description": "Request body in JSON format that will be returned in the response if authentication is successful.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {
                "message": "Hello World",
                "payloadId": "12345"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Basic authentication successful",
                  "user": "testuser",
                  "data": {
                    "message": "Hello World",
                    "payloadId": "12345"
                  },
                  "timestamp": "2025-10-03T13:46:06.000Z"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized due to invalid or missing credentials."
          }
        }
      }
    },
    "/api/aws-signature": {
      "post": {
        "summary": "Validate AWS v4 Signature (Full)",
        "description": "Performs a full cryptographic validation of an AWS Signature Version 4 signature. It verifies the 'Authorization' and 'x-amz-date' headers to ensure the request is correctly signed.",
        "operationId": "validateAwsSignatureV4",
        "requestBody": {
          "description": "Request body in JSON format. The hash of this body is part of the signing process.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {
                "action": "getData",
                "resource": "items"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid AWS v4 signature.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "AWS Signature V4 authentication successful",
                  "accessKey": "AKIAIOSFODNN7EXAMPLE",
                  "region": "us-east-1",
                  "service": "execute-api",
                  "data": {
                    "action": "getData",
                    "resource": "items"
                  },
                  "timestamp": "2025-10-03T13:46:06.000Z"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized due to an invalid signature, incorrect access key, or wrong header forma."
          }
        }
      }
    },
    "/api/aws-signature-simple": {
      "post": {
        "summary": "Verify AWS v4 Signature Format (Simplified)",
        "description": "Verifies only that the 'Authorization' and 'x-amz-date' headers have the correct format for AWS Signature V4, but does not perform cryptographic validation of the signature.",
        "operationId": "checkAwsSignatureV4Format",
        "requestBody": {
          "description": "Request body in JSON format.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {
                "action": "ping"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The header format is valid.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "AWS Signature V4 format valid (simplified check)",
                  "note": "This endpoint only validates header format, not the actual signature",
                  "accessKey": "AKIAIOSFODNN7EXAMPLE",
                  "data": {
                    "action": "ping"
                  },
                  "timestamp": "2025-10-03T13:46:06.000Z"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized due to an incorrect or missing header format."
          }
        }
      }
    },
    "/api/test-credentials": {
      "get": {
        "summary": "Get Test Credentials",
        "description": "Returns a set of test credentials for Basic Auth and AWS Signature V4 that can be used to interact with the other endpoints of this API.",
        "operationId": "getTestCredentials",
        "responses": {
          "200": {
            "description": "Test credentials obtained successfully.",
            "content": {
              "application/json": {
                "example": {
                  "basicAuth": {
                    "description": "Use these credentials for Basic Authentication",
                    "users": [
                      {
                        "username": "testuser",
                        "password": "testpass123"
                      }
                    ]
                  },
                  "awsSignature": {
                    "description": "Use these credentials for AWS Signature V4",
                    "credentials": [
                      {
                        "accessKeyId": "AKIAIOSFODNN7EXAMPLE",
                        "secretAccessKey": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/logs": {
      "get": {
        "summary": "View Request Logs",
        "description": "Displays a history of the last 10 requests that were successfully authenticated by the API, in descending order.",
        "operationId": "getRequestLogs",
        "responses": {
          "200": {
            "description": "Request logs obtained successfully.",
            "content": {
              "application/json": {
                "example": {
                  "totalRequests": 5,
                  "recentLogs": [
                    {
                      "timestamp": "2025-10-03T13:46:06.000Z",
                      "method": "POST",
                      "endpoint": "/api/basic-auth",
                      "auth": "basic",
                      "user": "testuser",
                      "body": {
                        "message": "Hello"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
